<?xml version="1.0" encoding="UTF-8"?>
<subsubsection xml:id="materials"><title>Materials and Resources</title>
        <paragraphs xml:id="texts"><title>Primary Reference</title>
                <p>
                        The main text for this course will be
                        <url href="https://scholarworks.gvsu.edu/cgi/viewcontent.cgi?article=1012&amp;context=books#page=7" visual='scholarworks.gvsu.edu/cgi/viewcontent.cgi?article=1012&amp;context=books'>Trigonometry</url> by Ted Sundstrom and Steven Schlicker. 
                        This PDF is a free, open educational resource.
                        </p>
        </paragraphs>
        <paragraphs xml:id="readings"><title>Additional Materials</title> 
                        <p>
                                We will also use
<url href="https://yoshiwarabooks.org/trig/frontmatter.html" visual='yoshiwarabooks.org/trig/frontmatter.html' >Trigonometry</url> by Katherine Yoshiwara. 
                        This is an online, free, open educational resource.
                </p>
                <p>
                        Any required supplementary material used will be put placed on BlackBoard, on reserve in the library, or otherwise made available to you.
                </p>
        </paragraphs>
</subsubsection>
