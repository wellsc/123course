<?xml version="1.0" encoding="UTF-8"?>
<prefigure xmlns="https://prefigure.org" label="knight_moves">
        <diagram dimensions="(600,600)" margins="15" >
          <definition>start=(0,0)</definition>
          <definition>m1=(1,2)</definition>
          <definition>i1=(0,2)</definition>
          <definition>m2=(2,1)</definition>
          <definition>i2=(2,0)</definition>

          <coordinates bbox="(-3,-3,3,3)">
            <grid spacings="((-3,1,3),(-3,1,3))"/>
            <point p="start" size="2" alignment="s" ><m>\textit{Start}</m></point>
            <point p="m1" size="2" alignment="n" ><m>\textit{Move 1}</m></point>
            <point p="m2" size="2" alignment="e" ><m>\textit{Move 2}</m></point>
            <polygon points="(start,i1,m1)" stroke="black" dash="4 4" />
            <polygon points="(start,i2,m2)" stroke="black" dash="4 4" />
          </coordinates>
        </diagram>
</prefigure>
