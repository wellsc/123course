<?xml version="1.0" encoding="UTF-8"?>
<prefigure xmlns="https://prefigure.org" label="law_of_cosines_triangle" >
<diagram dimensions="(600,480)" margins="5">
  <definition>C=(0,0)</definition>
  <definition>B=(8,0)</definition>
  <definition>A=(6,5)</definition>
  <definition>H=(6,0)</definition>
  <coordinates bbox="(-1,-1,9,7)">
    
    <line endpoints="(C,B)" alignment="s" ><m>a</m></line>
    <line endpoints="(A,B)" alignment="n" ><m>c</m></line>
    <line endpoints="(C,A)" alignment="n" ><m>b</m></line>
    <line endpoints="(A,H)" dash="4 4" alignment="n" offset="(0,6)" rotate="90" ><m>h</m></line>
    <line endpoints="(C,H)" alignment="n"><m>x</m></line>
    <line endpoints="(H,B)" alignment="n"><m>a-x</m></line>
    <angle-marker points="(A,H,C)" radius="10" />
    <point p="C" size="0" alignment="w" ><m>C</m></point>
    <point p="B" size="0" alignment="e" ><m>B</m></point>
    <point p="A" size="0" alignment="n" ><m>A</m></point>
    <point p="H" size="0" alignment="s" ><m>H</m></point>
    
  </coordinates>

</diagram>
</prefigure>
