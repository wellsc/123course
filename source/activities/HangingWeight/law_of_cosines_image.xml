<?xml version="1.0" encoding="UTF-8"?>
<prefigure xmlns="https://prefigure.org" label="law_of_cosines_triangle" >
<diagram dimensions="(300,270)" margins="5">
  <definition>A=(0,0)</definition>
  <definition>B=(6,0)</definition>
  <definition>C=(8,5)</definition>
  <definition>D=(8,0)</definition>
  <coordinates bbox="(-1,-2,9,7)">
    
    <line endpoints="(A,B)" alignment="s" offset="(50,-10)" ></line>
    <line endpoints="(A-(0,1),D-(0,1))" dash="4 4" arrows="2" alignment="s" ><m>c+x</m></line>
    <line endpoints="(B,C)" alignment="n" ><m>a</m></line>
    <line endpoints="(A,C)" alignment="n" ><m>b</m></line>
    <line endpoints="(C,D)" dash="4 4" alignment="n" offset="(0,6)" rotate="90" ><m>h</m></line>
    <line endpoints="(A,B)" alignment="n"><m>c</m></line>
    <line endpoints="(B,D)" alignment="n" dash="4 4" ><m>x</m></line>
    <angle-marker points="(C,D,A)" radius="10" />
    <point p="A" size="0" alignment="sw" ><m>A</m></point>
    <point p="B" size="0" alignment="s" ><m>B</m></point>
    <point p="C" size="0" alignment="n" ><m>C</m></point>
    <point p="D" size="0" alignment="se" ><m>D</m></point>
  </coordinates>
</diagram>
</prefigure>
