<?xml version='1.0' encoding='utf-8'?>

<prefigure xmlns="https://prefigure.org" label="prefig_train2">
<diagram dimensions="(500,350)" margins="5">
  <definition>C=(0,0)</definition>
  <definition>T=(0,5)</definition>
  <definition>L=(-3.5,5)</definition>
  <definition>R=(3.5,5)</definition>
  <definition>theta=pi/6</definition>
  <definition>u=(cos(-theta),sin(-theta))</definition>
  <definition>cab_lr=(5*tan(theta),5)</definition>
  <definition>cablength=0.6</definition>
  <definition>cabheight=0.2</definition>
  <definition>cab_ll=cab_lr-(cablength,0)</definition>
  <definition>cab_ul=cab_ll+(0,cabheight)</definition>
  <definition>cab_window=cab_ul+(cablength-cabheight,0)</definition>
  <coordinates bbox="(-4,-1,6,6)">

    <!-- Train track -->
    <line endpoints="(L,R)" infinite="yes" thickness="1"/>

    <!-- Camera arc -->
    <arc center="C" 
        radius="5" 
        range="(50,130)" 
        stroke="black" 
        dash="4 4"
    />

    <!-- Perpendicular from camera to train track -->
    <line endpoints="(C,T)" dash="4 4"><m>50\text{m}</m></line>

    <line endpoints="(C,cab_lr)" dash="4 4" />
    <angle-marker points="(cab_lr,C,T)" radius="90"><m>\frac{\pi}{6}</m></angle-marker>
    
    <point p="C" fill="black" alignment="se">camera</point>
    
    <!-- Train cab -->
    <path start="cab_lr" stroke="black" closed="yes" thickness="3">
      <lineto point="cab_ll"/>
      <lineto point="cab_ul"/>
      <lineto point="cab_window"/>
      <arc radius="0.2" range="(90,0)" center="cab_lr-(cabheight,0)"/>
    </path>
    <!-- Train cars -->
    <repeat parameter="k=1..5">
      <path start="cab_ll+(-k*cablength,0)" stroke="black" closed="yes" thickness="3" >
        <lineto point="cab_ll+(-k*cablength,cabheight)" />
        <lineto point="cab_ll+(-k*cablength,cabheight)-(cabheight/2-cablength, 0)" />
        <lineto point="cab_ll-((k-1)*cablength+cabheight/2,0)" />
      </path>
    </repeat>
    
    <!-- Train velocity -->
    <line endpoints="(cab_lr,cab_lr+(2*1.56,0))" 
          thickness="2" 
          arrows="1"><m>15.6\text{m}/\text{s}</m></line>
    <vector v="2*1.56*u" tail="cab_lr" thickness="1"><m>\vec{v}_{T}</m></vector>
  </coordinates>
</diagram>

</prefigure>
