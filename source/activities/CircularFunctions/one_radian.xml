<?xml version="1.0" encoding="UTF-8"?>
<prefigure xmlns="https://prefigure.org" label="one_radian">
<diagram dimensions="(300,300)" margins="5">
  <definition>O=(0,0)</definition>
  <definition>a=(1,0)</definition>
  <definition>b=(cos(1),sin(1))</definition>
  <definition>A=3*a</definition>
  <definition>B=3*b</definition>
  <coordinates bbox="(-3.3,-3.3,3.3,3.3)">
    <axes decorations="no" thickness="1" />
    
    <point p="A" alignment="se" size="0" offset="(0,-5)" >
      <m>A</m>
    </point>
    <point p="B" alignment="n" size="0" offset="(0,3)" >
      <m>B</m>
    </point>
    <point p="a" alignment="se" size="0" offset="(0,-5)" >
      <m>a</m>
    </point>
    <point p="b" alignment="nw" size="0" offset="(0,3)">
      <m>b</m>
    </point>
    <circle center="O" radius="1" thickness="1" />
    <circle center="O" radius="3" thickness="1" />
    <arc center="O" radius="1" range="(0,180/pi)" thickness="3" stroke="black" />
    <arc center="O" radius="3" range="(0,180/pi)" thickness="3" stroke="black" />

    <polygon points="(1.1*A,O,1.1*B)" stroke="black" thickness="2" />
        
  </coordinates>

</diagram>
</prefigure>
