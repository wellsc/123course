<?xml version="1.0" encoding="UTF-8"?>
<prefigure xmlns="https://prefigure.org" label="unit_circle_theta" >
<diagram dimensions="(300,300)" margins="15">
  <definition>O=(0,0)</definition>
  <definition>theta=pi/3</definition>
  <definition>P=(cos(theta),sin(theta))</definition>
  <definition>A=(1,0)</definition>
  <coordinates bbox="(-1.3,-1.3,1.3,1.3)">
    <axes decorations="no" xlabel="x" ylabel="y" />
    <point p="P" alignment="ne" size="3" fill="black" offset="(0,3)" >
      <m>P</m>
    </point>
    <point p="O" alignment="sw" size="3" fill="black" offset="(0,0)" >
      <m>(0,0)</m>
    </point>
    <point p="A" alignment="se" size="3" fill="black" offset="(0,0)" >
      <m>(1,0)</m>
    </point>
    <circle center="O" radius="1" />
    <line endpoints="(O,P)" ><m>1</m></line>
    <angle-marker points="(A,O,P)" arrow="yes" ><m>\theta</m></angle-marker>      
  </coordinates>
</diagram>
</prefigure>
