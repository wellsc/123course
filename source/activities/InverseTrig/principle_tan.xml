<?xml version="1.0" encoding="UTF-8"?>
<prefigure xmlns="https://prefigure.org" label="principle_tan">
<diagram dimensions="(500,500)" margins="20">
  <definition>f(x)=tan(x)</definition>
  <coordinates bbox="(-2.5*pi,-2.5*pi,2.5*pi,2.5*pi)">
    <axes 
      arrows="0" 
      thickness="1" 
      h-pi-format="yes" 
      hticks="(-2.75*pi,pi/4,2.75*pi)" 
      hlabels="(-2*pi,pi/2,2*pi)" 
      vticks="(-8,1,8)"
    />
    
      <graph function="f" thickness="1" />
    <graph function="f" domain="(-pi/2,pi/2)" thickness="4" />
    <line endpoints="((-5*pi/2,-1),(-5*pi/2,1))" thickness="1" infinite="yes" dash="2 4" />
    <line endpoints="((-3*pi/2,-1),(-3*pi/2,1))" thickness="1" infinite="yes" dash="2 4" />
    <line endpoints="((-pi/2,-1),(-pi/2,1))" thickness="1" infinite="yes" dash="2 4" />
    <line endpoints="((pi/2,-1),(pi/2,1))" thickness="1" infinite="yes" dash="2 4" />
    <line endpoints="((3*pi/2,-1),(3*pi/2,1))" thickness="1" infinite="yes" dash="2 4" />
    <line endpoints="((5*pi/2,-1),(5*pi/2,1))" thickness="1" infinite="yes" dash="2 4" />
  </coordinates>

</diagram>
</prefigure>
