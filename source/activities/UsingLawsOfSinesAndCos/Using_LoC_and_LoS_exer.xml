<?xml version="1.0" encoding="UTF-8"?>

<prefigure xmlns="https://prefigure.org" label="prefig_using_LOC_and_LOS_exercise">
<diagram dimensions="(600,375)" margins="5">
  <definition>theta=1/5*pi</definition>
  <definition>a=25</definition>
  <definition>b=30</definition>
  <definition>C=(0,0)</definition>
  <definition>A=(b,0)</definition>
  <definition>B=(a*cos(theta),a*sin(theta))</definition>
  <coordinates bbox="(-5,-5,35,20)">
    <triangle vertices="(A,B,C)" labels="A,B,C" />
    <angle-marker at="aC" points="(A,C,B)" radius="100" >
      <m>\pi/${round(pi/theta)}</m>
    </angle-marker>

    <line at="AC" endpoints="(C,A)"><m>${b}\text{cm}</m></line>
    <line at="BC" endpoints="(C,B)"><m>${a}\text{cm}</m></line>

  </coordinates>

  <annotations text="A triangle with two side lengths and the measure of the included angle given">
    <annotation ref="AC" text="Side AC, whose length is 30 cm" />
    <annotation ref="BC" text="Side BC, whose length is 25 cm" />
    <annotation ref="aC" text="Angle C, whose measure is pi over five" />
  </annotations>
</diagram>
</prefigure>
